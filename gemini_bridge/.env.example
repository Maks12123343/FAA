HOST=127.0.0.1
PORT=4981
LOCAL_API_KEY=replace-with-a-long-random-local-key
# Browser mode is preferred. It uses a separate persistent Chrome profile and
# lets the bridge refresh the current Gemini session automatically.
# auto = use browser profile when it exists, otherwise fall back to cookies.
GEMINI_BROWSER_MODE=auto
# Optional. Default: %LOCALAPPDATA%\FAA\gemini_browser_profile
# GEMINI_BROWSER_PROFILE=
# Legacy fallback only. Leave blank when browser mode is configured.
GEMINI_1PSID=
GEMINI_1PSIDTS=
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_LANGUAGE=en
REQUEST_TIMEOUT_SECONDS=360
MAX_IMAGE_BYTES=52428800
