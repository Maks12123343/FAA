HOST=127.0.0.1
PORT=4981
LOCAL_API_KEY=replace-with-a-long-random-local-key
# Flow uses a dedicated persistent Chrome profile outside the repository.
# Cookies and refresh state stay in that browser profile; do not paste them here.
FLOW_PROFILE=faa
# Optional. Default: %LOCALAPPDATA%\FAA\flow_browser
# FLOW_HOME=%LOCALAPPDATA%\FAA\flow_browser
# flow-nano-pro = Nano Banana Pro; flow-nano2 = Nano Banana 2; flow-image4 = Imagen 4
FLOW_MODEL=flow-nano-pro
FLOW_RETRIES=3
REQUEST_TIMEOUT_SECONDS=600
MAX_IMAGE_BYTES=52428800
